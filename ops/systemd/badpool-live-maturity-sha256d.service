[Unit]
Description=Badpool live block maturity (SHA256d; production activation gated)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zako
WorkingDirectory=/srv/badpool/yiimp-badpool/web
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/php yaamp/yiic.php liveblockmaturity --coin=1270 --algo=sha256 --after=32014 --limit=10 --lane=live-sha256d-v1
