[Unit]
Description=Badpool live payment coordinator (Yescrypt)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zako
WorkingDirectory=/srv/badpool/yiimp-badpool/web
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/php yaamp/yiic.php badpoolguard live-payment-coordinator --lane-id=live-yescrypt-v1 --format=json
